<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="Mostrá tus productos con fotos, precios y un botón de WhatsApp listo para vender. Sin armar una tienda complicada."><title>Catálogo Visual — tu catálogo visual</title><style>
:root{--bg:#0b1020;--panel:#121a2e;--text:#f5f7ff;--muted:#aab4ce;--line:#283451;--accent:#8b7cff;--accent2:#35d6b4;--white:#fff}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:radial-gradient(circle at 80% 0%,#20264b 0,transparent 35%),var(--bg);color:var(--text);line-height:1.55}
a{color:inherit;text-decoration:none}.wrap{width:min(1120px,92%);margin:auto}.nav{display:flex;align-items:center;justify-content:space-between;padding:22px 0;gap:18px}.brand{font-weight:850;letter-spacing:-.04em;font-size:1.2rem;display:flex;align-items:center;gap:10px}.logo{width:36px;height:36px;border-radius:12px;background:linear-gradient(135deg,var(--accent),var(--accent2));display:grid;place-items:center;color:#0b1020;font-weight:900}.navlinks{display:flex;gap:22px;color:var(--muted);font-size:.94rem}.navlinks a:hover{color:var(--text)}.btn{display:inline-flex;justify-content:center;align-items:center;gap:8px;padding:12px 18px;border:1px solid var(--line);border-radius:13px;font-weight:750;background:#1a2340;color:var(--text);cursor:pointer;transition:.2s}.btn:hover{transform:translateY(-2px);border-color:var(--accent)}.btn.primary{background:linear-gradient(135deg,var(--accent),#6b65e8);border:0;color:white}.btn.mint{background:var(--accent2);color:#071b1a;border:0}.hero{padding:70px 0 54px;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:42px}.eyebrow{display:inline-flex;padding:7px 11px;border:1px solid #3b426b;border-radius:999px;color:#c7c4ff;background:#171b39;font-size:.83rem;font-weight:700}.hero h1{font-size:clamp(2.5rem,5vw,4.6rem);line-height:1.02;letter-spacing:-.065em;margin:18px 0}.hero p{color:var(--muted);font-size:1.1rem;max-width:620px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}.mock{background:linear-gradient(160deg,#1b2543,#11182b);border:1px solid #303b5c;border-radius:28px;padding:22px;box-shadow:0 25px 90px #0005}.mock-top{display:flex;justify-content:space-between;color:var(--muted);font-size:.82rem;margin-bottom:18px}.phone{width:min(100%,330px);margin:auto;background:#f7f7fb;color:#182033;border-radius:25px;padding:15px;box-shadow:0 15px 50px #0004}.phone-head{text-align:center;padding:14px}.avatar{width:60px;height:60px;border-radius:50%;margin:0 auto 10px;background:linear-gradient(135deg,#9a8bff,#45dfbd);display:grid;place-items:center;font-size:1.4rem;font-weight:900}.product{display:flex;align-items:center;gap:12px;padding:10px;border-radius:14px;background:#fff;margin:9px 0;box-shadow:0 3px 10px #1111}.product .thumb{width:55px;height:55px;border-radius:11px;background:linear-gradient(135deg,#ddd8ff,#c8fff1);display:grid;place-items:center;font-size:1.5rem}.product small{display:block;color:#737b90}.product button{margin-left:auto;border:0;background:#17213c;color:white;padding:8px;border-radius:9px}.section{padding:55px 0}.section-head{text-align:center;max-width:700px;margin:0 auto 30px}.section h2{font-size:clamp(1.8rem,3vw,2.8rem);letter-spacing:-.04em;margin:0 0 10px}.muted{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.feature,.price-card{background:linear-gradient(160deg,#151e34,#101629);border:1px solid var(--line);border-radius:20px;padding:23px}.feature .emoji{font-size:1.7rem}.feature h3{margin:12px 0 5px}.feature p{color:var(--muted);margin:0}.pricing{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;max-width:820px;margin:auto}.price-card.pro{border-color:var(--accent);box-shadow:0 0 0 1px #8b7cff33,0 20px 70px #5147c322}.price{font-size:2.5rem;font-weight:850;letter-spacing:-.06em;margin:10px 0}.price span{font-size:.95rem;color:var(--muted);font-weight:500;letter-spacing:0}.price-card ul{padding-left:20px;color:var(--muted);min-height:125px}.price-card li{margin:7px 0}.tag{font-size:.75rem;background:#29234f;color:#d9d4ff;border-radius:999px;padding:5px 9px;font-weight:800}.faq{max-width:800px;margin:auto}.faq details{padding:17px 0;border-bottom:1px solid var(--line)}.faq summary{font-weight:750;cursor:pointer}.faq p{color:var(--muted)}.footer{border-top:1px solid var(--line);padding:25px 0;color:var(--muted);font-size:.9rem;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.notice{font-size:.85rem;color:#d5d9e8;background:#191f36;border:1px solid #313958;padding:12px 14px;border-radius:12px;margin-top:15px}.pill{display:inline-block;border-radius:999px;background:#1b2740;padding:6px 10px;font-size:.8rem;color:#c7d4f2}
@media(max-width:760px){.hero{grid-template-columns:1fr;padding-top:42px}.hero h1{font-size:3rem}.navlinks{display:none}.grid{grid-template-columns:1fr}.pricing{grid-template-columns:1fr}.mock{padding:14px}.section{padding:42px 0}.footer{display:block}}
</style></head>
