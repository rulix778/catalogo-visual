<footer class="wrap footer"><span>© 2026 Catálogo Visual · Prototipo inicial</span><span>Privacidad · Términos · Contacto (agregar antes de publicar)</span></footer><script>
let cart={}, total=0;
function demoAction(product){alert('Demo: aquí se abriría WhatsApp para consultar por '+product+'. Configurá tu número para activar el enlace real.')}
function addCart(name,price){cart[name]=(cart[name]||0)+1;total+=price;let count=Object.values(cart).reduce((a,b)=>a+b,0);document.getElementById('cartcount').textContent='Pedido: '+count+' productos';document.getElementById('carttotal').textContent='Total: ARS '+total.toLocaleString('es-AR')}
function sendOrder(){if(!total){alert('Agregá al menos un producto.');return}let items=Object.entries(cart).map(([n,q])=>q+' x '+n).join(', ');alert('Demo de pedido: '+items+' — Total ARS '+total.toLocaleString('es-AR')+'. En producción se abriría WhatsApp del comercio.')}
const vf=document.getElementById('videoFile'); if(vf){vf.addEventListener('change',e=>{const f=e.target.files[0];if(!f)return;const v=document.getElementById('videoPreview');v.src=URL.createObjectURL(f);v.onloadedmetadata=()=>{document.getElementById('clipEnd').value=Math.min(15,Math.floor(v.duration)||15);document.getElementById('clipStatus').textContent='Video cargado ('+Math.round(v.duration)+' s). Ajustá inicio y final para preparar tu recorte.'}});document.getElementById('clipStart').addEventListener('change',()=>document.getElementById('clipStatus').textContent='Fragmento seleccionado. La exportación real requiere integrar un motor de video.');document.getElementById('clipEnd').addEventListener('change',()=>document.getElementById('clipStatus').textContent='Fragmento seleccionado. La exportación real requiere integrar un motor de video.')}
function subscribe(plan){alert('Plan '+plan+': esta es una maqueta. Para cobrar suscripciones hay que conectar un proveedor de pagos y un backend seguro.')}
</script></body></html>
